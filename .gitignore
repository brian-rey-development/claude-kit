# The CLI's own Python environment, made by bin/kit on first run.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Generated by claude-kit from every theme it can find.
mods/welcome/hooks/cards.ts

# Written by Claude Code when it loads a mod.
mods/*/.claude-plugin/types/

# Fonts are built on each machine from Apple's Monaco and must never be committed.
*.ttf

.DS_Store
